# 统一换行符：仓库内一律 LF，避免 shell 脚本被 Windows 的 autocrlf 改成 CRLF
# （CRLF 的 .sh 在 Linux 上会报 "bad interpreter: /bin/bash^M"）
* text=auto eol=lf

*.sh        text eol=lf
Dockerfile  text eol=lf
*.go        text eol=lf
*.ts        text eol=lf
*.tsx       text eol=lf
*.css       text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.txt       text eol=lf
Makefile    text eol=lf
*.conf      text eol=lf
*.example   text eol=lf

# Windows 批处理必须 CRLF
*.bat       text eol=crlf
*.cmd       text eol=crlf

# 二进制资源不做换行转换
*.png       binary
*.jpg       binary
*.webp      binary
*.ico       binary
*.woff      binary
*.woff2     binary
*.wasm      binary
